# Build context is the repo root (diya/), not apps/api-gateway, because every
# service now depends on the shared packages/core-py package.
FROM python:3.12-slim

WORKDIR /app

COPY packages/core-py /opt/diya-core
COPY apps/api-gateway/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir /opt/diya-core

COPY apps/api-gateway/ .
# Seed data is the canonical source of truth for the in-memory store.
COPY data/synthetic /app/data/synthetic
ENV DIYA_DATA_DIR=/app/data/synthetic

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
