# Build context is the repo root (diya/) — see Dockerfile.api-gateway.
FROM python:3.12-slim

WORKDIR /app

COPY packages/core-py /opt/diya-core
COPY apps/agent-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir /opt/diya-core

COPY apps/agent-service/ .
COPY data/synthetic /app/data/synthetic
ENV DIYA_DATA_DIR=/app/data/synthetic

RUN mkdir -p /app/.memory
ENV MEMORY_DIR=/app/.memory

EXPOSE 8002

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
